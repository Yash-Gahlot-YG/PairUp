{
  "expo": {
    "name": "PairUp",
    "slug": "pairup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dating-03.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/dating-06.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dating-04.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yash_gahlot.ProxiMate",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "34886b6d-2702-46cd-9cb1-158351327a5b"
      }
    },
    "owner": "yashh-gahlot"
  }
}
